Local devnet patch, not for merging: switches ethlambda to the VRF leaf of
consensus-specs pq at 4595f0fc, which ethpandaops/lighthouse:pq-devnet-0,
ethPandaOps' genesis generator and ethereum-package's published VRF states
follow. This branch tracks b5d422b2. Apply from the repository root with
`git apply tooling/pq-devnet/vrf-4595f0fc.patch` before building the image.

diff --git a/crates/common/crypto/src/vrf.rs b/crates/common/crypto/src/vrf.rs
index 1cdc6d8e..16b9e722 100644
--- a/crates/common/crypto/src/vrf.rs
+++ b/crates/common/crypto/src/vrf.rs
@@ -84,16 +84,19 @@ fn hash_pair(left: &Node, right: &Node) -> Node {
     keccak256(&[left, right])
 }

-/// `compute_vrf_secret`: the secret for `index` of the VRF tree derived from
-/// `vrf_seed`.
+/// LOCAL DEVNET PATCH, not for review: pq-devnet-0's VRF rule (consensus-specs
+/// `pq` at `4595f0fc`), which Lighthouse's `pq-devnet-0` image and
+/// ethPandaOps' genesis tooling follow. Its leaf is
+/// `keccak256(vrf_seed || le64(index))` and its reveal is that leaf, so the
+/// "secret" here is the leaf and [`compute_vrf_leaf`] passes it through.
 pub fn compute_vrf_secret(vrf_seed: &Node, index: u64) -> Node {
-    keccak256(&[VRF_SECRET_DOMAIN, vrf_seed, &index.to_le_bytes()])
+    let _ = (VRF_SECRET_DOMAIN, VRF_LEAF_DOMAIN);
+    keccak256(&[vrf_seed, &index.to_le_bytes()])
 }

-/// `compute_vrf_leaf`: the leaf at `index` of a VRF tree, which commits to
-/// `secret`.
-pub fn compute_vrf_leaf(secret: &Node, index: u64) -> Node {
-    keccak256(&[VRF_LEAF_DOMAIN, secret, &index.to_le_bytes()])
+/// LOCAL DEVNET PATCH: under pq-devnet-0's rule the revealed value is the leaf.
+pub fn compute_vrf_leaf(secret: &Node, _index: u64) -> Node {
+    *secret
 }

 /// `compute_vrf_node`: the node at `index` among the nodes `height` levels
